From: Hauke Mehrtens <hauke@hauke-m.de>
Subject: [PATCH] ubusd_acl: check credential string allocations on the legacy baseline

Applicable subset of upstream commit
07d7f34ac278c28817b41c8814df2cc1d303495f.  The b32a0e17 baseline has no
supplementary-group array, so only the two credential allocations exist here.

--- a/ubusd_acl.c
+++ b/ubusd_acl.c
@@ -187,7 +187,16 @@ ubusd_acl_init_client(struct ubus_client *cl, int fd)
 	cl->gid = cred.gid;
 
	cl->group = strdup(group->gr_name);
+	if (!cl->group) {
+		return -1;
+	}
+
	cl->user = strdup(pwd->pw_name);
+	if (!cl->user) {
+		free(cl->group);
+		cl->group = NULL;
+		return -1;
+	}
 
 	return 0;
 }
