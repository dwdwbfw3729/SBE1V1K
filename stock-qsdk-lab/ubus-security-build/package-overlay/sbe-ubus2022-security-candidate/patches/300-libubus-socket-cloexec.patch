From: Hauke Mehrtens <hauke@hauke-m.de>
Subject: [PATCH] libubus: set FD_CLOEXEC correctly on the legacy socket

Applicable reconnect subset of upstream commit
bcc45ca981fd61e11934776bcee18f628156a7f7.  The b32a0e17 baseline has no
channel-connect API, so that upstream hunk is intentionally inapplicable.

--- a/libubus-io.c
+++ b/libubus-io.c
@@ -415,9 +415,13 @@ int ubus_reconnect(struct ubus_context *ctx, const char *path)
 	ctx->local_id = hdr.hdr.peer;
 	if (!ctx->local_id)
 		goto out_free;
 
-	ret = UBUS_STATUS_OK;
-	fcntl(ctx->sock.fd, F_SETFL, fcntl(ctx->sock.fd, F_GETFL) | O_NONBLOCK | O_CLOEXEC);
+	int flags = fcntl(ctx->sock.fd, F_GETFL);
+	if (flags < 0 ||
+	    fcntl(ctx->sock.fd, F_SETFL, flags | O_NONBLOCK) < 0 ||
+	    fcntl(ctx->sock.fd, F_SETFD, FD_CLOEXEC) < 0)
+		goto out_free;
 
+	ret = UBUS_STATUS_OK;
 	ubus_refresh_state(ctx);
 
 out_free:
