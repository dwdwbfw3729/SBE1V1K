# Merge only after running Qualcomm's setup-environment for ipq95xx/64/premium.
# Kernel packages selected transitively here are NOT release artifacts; the
# stock-config build and ABI gate produce the only eligible .ko candidates.
CONFIG_PACKAGE_iptables-mod-tproxy=m
CONFIG_PACKAGE_iptables-mod-iprange=m
CONFIG_PACKAGE_sbe-dnsmasq293-candidate=m
CONFIG_PACKAGE_sbe-dropbear2026-candidate=m

# Keep the stock ipset 7.3 userspace/kernel family for the first trial.
# Do not select QSDK dnsmasq-full 2.80: it is older than the stock 2.89 binary
# and is not an acceptable long-term replacement.
# CONFIG_PACKAGE_dnsmasq-full is not set

