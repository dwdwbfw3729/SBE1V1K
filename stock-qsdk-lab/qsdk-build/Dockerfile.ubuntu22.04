FROM ubuntu:22.04

ARG UBUNTU_MIRROR=http://mirrors.ustc.edu.cn/ubuntu-ports/
ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i "s|http://ports.ubuntu.com/ubuntu-ports/|${UBUNTU_MIRROR}|g" \
      /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update \
 && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y \
      --no-install-recommends \
      aria2 \
      bc \
      bison \
      build-essential \
      bzip2 \
      ca-certificates \
      clang \
      curl \
      file \
      flex \
      g++ \
      gawk \
      gettext \
      gnupg \
      git \
      libelf-dev \
      liblzma-dev \
      libncurses-dev \
      libssl-dev \
      python3-dev \
      python3-setuptools \
      rsync \
      subversion \
      swig \
      squashfs-tools \
      u-boot-tools \
      time \
      unzip \
      wget \
      xxd \
      zlib1g-dev \
      zstd \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 openwrt \
 && useradd --uid 10001 --gid openwrt --create-home --shell /bin/bash openwrt

USER openwrt
WORKDIR /workspace
