+static json_object *statefiles_json_from_fd(int fd)
+{
+	struct json_tokener *tok;
+	struct stat st;
+	json_object *json;
+	char *data;
+	ssize_t n;
+	size_t off = 0;
+
+	if (fstat(fd, &st) || st.st_size < 0 || st.st_size > 1024 * 1024) {
+		errno = EFBIG;
+		return NULL;
+	}
+
+	data = calloc(1, (size_t)st.st_size + 1);
+	if (!data)
+		return NULL;
+
+	while (off < (size_t)st.st_size) {
+		n = read(fd, data + off, (size_t)st.st_size - off);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			break;
+		off += (size_t)n;
+	}
+
+	if (off != (size_t)st.st_size) {
+		free(data);
+		errno = EIO;
+		return NULL;
+	}
+
+	tok = json_tokener_new();
+	if (!tok) {
+		free(data);
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	json = json_tokener_parse_ex(tok, data, (int)off);
+	if (json_tokener_get_error(tok) != json_tokener_success) {
+		if (json)
+			json_object_put(json);
+		json = NULL;
+		errno = EINVAL;
+	}
+
+	json_tokener_free(tok);
+	free(data);
+	return json;
+}
