+static int statefiles_mkdir_p(char *path, mode_t mode)
+{
+	char *cursor;
+
+	if (!path || !*path) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	for (cursor = path + 1; *cursor; cursor++) {
+		if (*cursor != '/')
+			continue;
+
+		*cursor = '\0';
+		if (mkdir(path, mode) && errno != EEXIST) {
+			*cursor = '/';
+			return -1;
+		}
+		*cursor = '/';
+	}
+
+	if (mkdir(path, mode) && errno != EEXIST)
+		return -1;
+
+	return 0;
+}
