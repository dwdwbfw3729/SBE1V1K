From: SBE core-userland compatibility build
Subject: rpcd: retain the clamped 32-bit uloop timeout ABI

QSDK SPF12.2 carries libubox 66195aee, before
uloop_timeout_remaining64().  rpcd already clamps every session timer passed
to uloop_timeout_set() to INT_MAX, so the old accessor cannot truncate a live
candidate timer.  Keep the wire value 64-bit without changing libubox.

--- a/session.c
+++ b/session.c
@@ -230,7 +230,7 @@ rpc_session_to_blob(struct rpc_session *ses, bool acls)
 
 	blobmsg_add_string(&buf, "ubus_rpc_session", ses->id);
 	blobmsg_add_u32(&buf, "timeout", ses->timeout);
-	blobmsg_add_u64(&buf, "expires", uloop_timeout_remaining64(&ses->t) / 1000);
+	blobmsg_add_u64(&buf, "expires", (uint64_t)uloop_timeout_remaining(&ses->t) / 1000);
 
 	if (acls) {
 		c = blobmsg_open_table(&buf, "acls");

