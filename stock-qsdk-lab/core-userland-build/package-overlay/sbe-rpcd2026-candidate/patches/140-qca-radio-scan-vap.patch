From: SBE QSDK compatibility build
Subject: iwinfo: scan through the active QCA VAP for legacy radios

The retained qcawificfg80211 driver exposes a physical wifiN netdev and one
or more athN VAP netdevs.  Frequency and capability queries work on wifiN,
but a scan on that physical netdev returns an empty list.  QCA publishes the
radio name in /sys/class/net/athN/parent, so resolve only scan requests through
the first matching VAP.  Other iwinfo calls and non-QCA devices are unchanged.

--- a/iwinfo.c
+++ b/iwinfo.c
@@ -18,6 +18,8 @@
 
 #include <sys/types.h>
+#include <stdio.h>
 #include <dirent.h>
+#include <string.h>
 #include <libubus.h>
 #include <iwinfo.h>
 #include <iwinfo/utils.h>
@@ -35,5 +37,6 @@
 static const struct iwinfo_ops *iw;
 static const char *ifname;
+static char qca_scan_ifname[64];
 
 enum {
 	RPC_D_DEVICE,
@@ -89,6 +92,59 @@
 }
 
 static void
+rpc_iwinfo_resolve_qca_scan_device(void)
+{
+	struct dirent *entry;
+	char parent[64];
+	char path[256];
+	char *newline;
+	DIR *dir;
+	FILE *file;
+
+	qca_scan_ifname[0] = '\0';
+
+	if (!ifname || strncmp(ifname, "wifi", 4))
+		return;
+
+	dir = opendir("/sys/class/net");
+	if (!dir)
+		return;
+
+	while ((entry = readdir(dir)) != NULL) {
+		if (entry->d_name[0] == '.')
+			continue;
+
+		if (snprintf(path, sizeof(path), "/sys/class/net/%s/parent",
+		             entry->d_name) >= (int)sizeof(path))
+			continue;
+
+		file = fopen(path, "r");
+		if (!file)
+			continue;
+
+		if (!fgets(parent, sizeof(parent), file)) {
+			fclose(file);
+			continue;
+		}
+
+		fclose(file);
+		newline = strpbrk(parent, "\r\n");
+		if (newline)
+			*newline = '\0';
+
+		if (strcmp(parent, ifname))
+			continue;
+
+		strncpy(qca_scan_ifname, entry->d_name,
+		        sizeof(qca_scan_ifname) - 1);
+		qca_scan_ifname[sizeof(qca_scan_ifname) - 1] = '\0';
+		break;
+	}
+
+	closedir(dir);
+}
+
+static void
 rpc_iwinfo_close(void)
 {
 	iw = NULL;
@@ -386,6 +442,17 @@
 
 	rv = rpc_iwinfo_open(msg);
 
+	if (!rv) {
+		rpc_iwinfo_resolve_qca_scan_device();
+		if (qca_scan_ifname[0]) {
+			iwinfo_finish();
+			ifname = qca_scan_ifname;
+			iw = iwinfo_backend(ifname);
+			if (!iw)
+				rv = UBUS_STATUS_NOT_FOUND;
+		}
+	}
+
 	if (rv)
 		return rv;
 
