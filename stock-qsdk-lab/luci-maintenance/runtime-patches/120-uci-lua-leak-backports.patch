diff --git a/package/system/uci/patches/100-lua-free-config-list.patch b/package/system/uci/patches/100-lua-free-config-list.patch
new file mode 100644
index 0000000..f5e54ac
--- /dev/null
+++ b/package/system/uci/patches/100-lua-free-config-list.patch
@@ -0,0 +1,38 @@
+From 19ceff323f1e2e7df26031a9fae29fff2edc65bd Mon Sep 17 00:00:00 2001
+From: Petr Stetiar <ynezz@true.cz>
+Date: Mon, 4 Nov 2019 22:41:18 +0100
+Subject: lua: fix memory leak in changes method
+
+Upstream: https://git.openwrt.org/project/uci/commit/?id=19ceff323f1e2e7df26031a9fae29fff2edc65bd
+---
+ lua/uci.c | 17 +++++++++--------
+ 1 file changed, 9 insertions(+), 8 deletions(-)
+
+--- a/lua/uci.c
++++ b/lua/uci.c
+@@ -877,16 +877,17 @@ uci_lua_changes(lua_State *L)
+ 	lua_newtable(L);
+ 	if (package) {
+ 		uci_lua_changes_pkg(L, ctx, package);
+-	} else {
+-		if (uci_list_configs(ctx, &config) != 0)
+-			goto done;
+-
+-		for(i = 0; config[i] != NULL; i++) {
+-			uci_lua_changes_pkg(L, ctx, config[i]);
+-		}
++		return 1;
+ 	}
+ 
+-done:
++	if ((uci_list_configs(ctx, &config) != UCI_OK) || !config)
++		return 1;
++
++	for (i = 0; config[i] != NULL; i++) {
++		uci_lua_changes_pkg(L, ctx, config[i]);
++	}
++
++	free(config);
+ 	return 1;
+ }
+ 
