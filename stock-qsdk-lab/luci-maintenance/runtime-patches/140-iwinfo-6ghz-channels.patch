diff --git a/package/network/utils/iwinfo/patches/110-sbe-6ghz-frequency-channel.patch b/package/network/utils/iwinfo/patches/110-sbe-6ghz-frequency-channel.patch
new file mode 100644
index 0000000..2b51473
--- /dev/null
+++ b/package/network/utils/iwinfo/patches/110-sbe-6ghz-frequency-channel.patch
@@ -0,0 +1,21 @@
+From: SBE QSDK compatibility build
+Subject: nl80211: convert 6 GHz frequencies to their real channel numbers
+
+The QSDK 2019 iwinfo snapshot predates the 6 GHz band and treats every
+frequency above 5 GHz as a 5 GHz channel.  Keep all existing conversions,
+but use the IEEE 6 GHz formula for the standard 5955--7115 MHz range.
+---
+ iwinfo_nl80211.c | 2 ++
+ 1 file changed, 2 insertions(+)
+
+--- a/iwinfo_nl80211.c
++++ b/iwinfo_nl80211.c
+@@ -592,6 +592,8 @@ static int nl80211_freq2channel(int freq)
+ 		return (freq - 4000) / 5;
+ 	else if(freq >= 56160 + 2160 * 1 && freq <= 56160 + 2160 * 6)
+ 		return (freq - 56160) / 2160;
++	else if (freq >= 5955 && freq <= 7115)
++		return (freq - 5950) / 5;
+ 	else
+ 		return (freq - 5000) / 5;
+ }
