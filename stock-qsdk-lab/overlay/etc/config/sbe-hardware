config thermal 'policy'
	option cooling_profile 'balanced'
	option early_start_c '75'
	option early_release_c '70'
	option early_fan_rpm '1500'
	option interval '10'
	option failsafe_rpm '4700'
	option missing_iot_ok '1'
	option fan_tolerance_rpm '500'
	option fan_rpm_max_age_seconds '12'
	option fan_fault_samples '11'
	option fan_hard_fault_samples '3'
	option fan_recovery_samples '1'
	option critical_state_samples '3'

config led 'status'
	option enabled '1'
	option track_wan '1'
	option ready 'blue_on'
	option connecting 'blue_breath'
	option connected 'blue_on'
	option disconnected 'red_blink'
	option reset 'red_white_blink'
	option upgrade 'alternate_breath'
	option error 'red_on'
