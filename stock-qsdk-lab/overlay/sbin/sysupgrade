#!/bin/sh
# SBE1V1K configuration backup/restore and strictly validated firmware upgrade.

set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

validator=/usr/libexec/sbe-backup-validate
work=

cleanup() {
	[ -z "$work" ] || rm -rf "$work"
}
trap cleanup 0 1 2 3 15

fail() {
	echo "sysupgrade: $*" >&2
	exit 1
}

new_workdir() {
	[ -z "$work" ] || fail "internal temporary directory was already allocated"
	work="$(mktemp -d /tmp/sbe-config-backup.XXXXXX)" ||
		fail "cannot create a private temporary directory"
	chmod 700 "$work"
}

safe_tmp_archive_path() {
	local local_name
	case "$1" in
		/tmp/*.tar.gz) ;;
		*) return 1 ;;
	esac
	local_name=${1#/tmp/}
	case "$local_name" in
		''|.*|*/*|*[!A-Za-z0-9._+-]*) return 1 ;;
	esac
	return 0
}

portable_relative_path() {
	local relative
	relative=$1
	case "$relative" in
		''|/*|-*|*//*|*[!A-Za-z0-9._@+,:/-]*) return 1 ;;
	esac
	case "/$relative/" in
		*/./*|*/../*) return 1 ;;
	esac
	return 0
}

source_parent_is_link() {
	local relative current old_ifs component count index
	relative=$1
	current=
	old_ifs=$IFS
	IFS=/
	set -- $relative
	IFS=$old_ifs
	count=$#
	index=0
	for component do
		index=$((index + 1))
		[ "$index" -lt "$count" ] || break
		current="$current/$component"
		[ ! -L "$current" ] || return 0
	done
	return 1
}

copy_backup_entry() {
	local relative source destination target
	relative=$1
	portable_relative_path "$relative" || fail "invalid selected backup path: $relative"
	source=/$relative
	[ -f "$source" ] || [ -L "$source" ] || return 0
	source_parent_is_link "$relative" &&
		fail "selected backup path has a symbolic-link parent: /$relative"
	destination="$work/stage/$relative"
	if grep -Fqx "$relative" "$work/list.raw" 2>/dev/null; then
		return 0
	fi
	[ ! -e "$destination" ] && [ ! -L "$destination" ] ||
		fail "selected backup paths conflict at: /$relative"
	mkdir -p "${destination%/*}"
	if [ -L "$source" ]; then
		target=$(readlink "$source") || fail "cannot read selected symbolic link: /$relative"
		case "$relative:$target" in
			etc/passwd:/tmp/etc/passwd|etc/group:/tmp/etc/group)
				[ -f "$target" ] && [ ! -L "$target" ] || fail "legacy account database is unavailable: /$relative"
				cp -p "$target" "$destination" || fail "cannot stage account database: /$relative"
				;;
			*) ln -s -- "$target" "$destination" || fail "cannot stage selected symbolic link: /$relative" ;;
		esac
	else
		cp -p "$source" "$destination" || fail "cannot stage selected file: /$relative"
	fi
	printf '%s\n' "$relative" >> "$work/list.raw"
}

copy_backup_file() {
	copy_backup_entry "$1"
}

copy_backup_tree() {
	local relative_root skip_pwm source_root source relative
	relative_root=$1
	skip_pwm=${2:-0}
	portable_relative_path "$relative_root" || fail "invalid selected backup tree: $relative_root"
	source_root=/$relative_root
	[ -d "$source_root" ] || return 0
	[ ! -L "$source_root" ] || {
		copy_backup_entry "$relative_root"
		return
	}
	source_parent_is_link "$relative_root" &&
		fail "selected backup tree has a symbolic-link parent: /$relative_root"
	find "$source_root" \( -type f -o -type l \) > "$work/tree-files"
	while IFS= read -r source; do
		relative=${source#/}
		[ "$relative" != "$source" ] || fail "unexpected backup source path"
		[ "$skip_pwm" != 1 ] || [ "$relative" != etc/config/pwm ] || continue
		copy_backup_entry "$relative"
	done < "$work/tree-files"
}

copy_dropbear_keys() {
	local source relative
	[ -d /etc/dropbear ] || return 0
	[ ! -L /etc/dropbear ] || return 0
	find /etc/dropbear \( -type f -o -type l \) > "$work/dropbear-files"
	while IFS= read -r source; do
		relative=${source#/}
		case "$relative" in
			etc/dropbear/authorized_keys|etc/dropbear/dropbear_*_host_key)
				copy_backup_file "$relative"
				;;
		esac
	done < "$work/dropbear-files"
}

copy_root_password() {
	local source destination root_count
	[ -f /etc/shadow ] || return 0
	if [ -L /etc/shadow ]; then
		[ "$(readlink /etc/shadow)" = /tmp/etc/shadow ] ||
			fail "unexpected active shadow database link target"
		source=/tmp/etc/shadow
	else
		source=/etc/shadow
	fi
	[ -f "$source" ] && [ ! -L "$source" ] ||
		fail "active shadow database is not a regular file"
	root_count=$(grep -c '^root:' /etc/shadow 2>/dev/null || true)
	[ "$root_count" = 1 ] || fail "current root password record is invalid"
	mkdir -p "$work/stage/etc"
	destination="$work/stage/etc/shadow"
	if grep -Fqx 'etc/shadow' "$work/list.raw" 2>/dev/null; then
		return 0
	fi
	cp -p "$source" "$destination" || fail "cannot stage active shadow database"
	printf '%s\n' 'etc/shadow' >> "$work/list.raw"
}

list_opkg_conffiles() {
	[ -f /usr/lib/opkg/status ] || return 0
	awk '
		BEGIN { conffiles = 0 }
		/^Conffiles:/ { conffiles = 1; next }
		!/^ / { conffiles = 0; next }
		conffiles == 1 { print }
	' /usr/lib/opkg/status
}

copy_changed_opkg_conffiles() {
	local file expected extra relative actual
	list_opkg_conffiles > "$work/opkg-conffiles"
	while read -r file expected extra; do
		[ -n "${file:-}" ] || continue
		case "$file" in
			/*) relative=${file#/} ;;
			*) fail "opkg conffile path is not absolute: $file" ;;
		esac
		[ -r "$file" ] || [ -L "$file" ] || continue
		actual=$(sha256sum "$file" 2>/dev/null | awk '{print $1}') || actual=
		[ -n "${expected:-}" ] && [ "$actual" = "$expected" ] && continue
		copy_backup_entry "$relative"
	done < "$work/opkg-conffiles"
}

copy_backup_pattern() {
	local pattern source relative
	pattern=$1
	case "$pattern" in
		/*) ;;
		*) return 0 ;;
	esac
	# OpenWrt sysupgrade.conf and keep.d entries are shell path patterns.  The
	# unquoted expansion intentionally implements their standard glob syntax;
	# the expanded result is validated before it is staged.
	for source in $pattern; do
		[ -e "$source" ] || [ -L "$source" ] || continue
		relative=${source#/}
		if [ -d "$source" ] && [ ! -L "$source" ]; then
			copy_backup_tree "$relative" 0
		else
			copy_backup_entry "$relative"
		fi
	done
}

copy_standard_backup_selections() {
	local selection_file pattern
	: > "$work/patterns"
	for selection_file in /etc/sysupgrade.conf /lib/upgrade/keep.d/*; do
		[ -f "$selection_file" ] || continue
		sed -ne '
			/^[[:space:]]*$/d
			/^[[:space:]]*#/d
			s/^[[:space:]]*//
			s/[[:space:]]*$//
			p
		' "$selection_file" >> "$work/patterns"
	done
	while IFS= read -r pattern; do
		copy_backup_pattern "$pattern"
	done < "$work/patterns"
	# Preserve the user's selection list itself even if its package checksum is
	# unchanged, so custom choices survive a backup/restore round trip.
	copy_backup_file etc/sysupgrade.conf
	copy_changed_opkg_conffiles
}

build_backup_stage() {
	mkdir -p "$work/stage"
	: > "$work/list.raw"

	for relative in \
		etc/hosts \
		etc/ethers \
		etc/firewall.user \
		etc/rc.local \
		etc/uhttpd.crt \
		etc/uhttpd.key \
		etc/crontabs/root
	do
		copy_backup_file "$relative"
	done

	for relative_root in \
		etc/config \
		etc/openvpn \
		etc/wireguard \
		etc/acme \
		etc/ssl/private \
		etc/passwall \
		etc/xray \
		etc/sing-box \
		root/.ssh
	do
		case "$relative_root" in
			etc/config) copy_backup_tree "$relative_root" 1 ;;
			*) copy_backup_tree "$relative_root" 0 ;;
		esac
	done

	copy_dropbear_keys
	copy_root_password
	copy_standard_backup_selections

	sort -u "$work/list.raw" > "$work/list"
	[ -s "$work/list" ] || fail "no configuration files are available to back up"
}

validate_gzip_archive() {
	local compressed list_output compressed_size
	compressed=$1
	list_output=$2
	compressed_size=$(wc -c < "$compressed")
	case "$compressed_size" in
		''|*[!0-9]*) fail "cannot determine archive size" ;;
	esac
	[ "$compressed_size" -le 16777216 ] ||
		fail "compressed archive exceeds the 16 MiB limit"
	gzip -t "$compressed" 2>/dev/null || fail "archive is not a valid gzip stream"
	(
		# POSIX file-size limit is expressed in 512-byte blocks.  This keeps a
		# gzip bomb from consuming more than 64 MiB of the RAM-backed /tmp.
		ulimit -f 131072
		gzip -dc "$compressed" > "$work/archive.tar"
	) 2>/dev/null || fail "archive expands beyond the 64 MiB safety limit"
	[ -x "$validator" ] || fail "strict backup validator is unavailable"
	"$validator" "$work/archive.tar" > "$list_output" ||
		fail "archive failed configuration safety validation"
}

create_backup() {
	local destination temporary_output
	destination=$1
	case "$destination" in
		-) ;;
		*)
			safe_tmp_archive_path "$destination" ||
				fail "backup output must be '-' or a simple /tmp/*.tar.gz path"
			[ ! -L "$destination" ] || fail "backup output must not be a symbolic link"
			;;
	esac

	new_workdir
	build_backup_stage
	tar -czf "$work/backup.tar.gz" -C "$work/stage" -T "$work/list" ||
		fail "could not create configuration archive"
	validate_gzip_archive "$work/backup.tar.gz" "$work/validated-list"
	cmp -s "$work/list" "$work/validated-list" ||
		fail "generated archive did not match the selected backup list"

	if [ "$destination" = - ]; then
		cat "$work/backup.tar.gz"
	else
		temporary_output="${destination}.new.$$"
		[ ! -e "$temporary_output" ] && [ ! -L "$temporary_output" ] ||
			fail "temporary backup output already exists"
		cp "$work/backup.tar.gz" "$temporary_output"
		chmod 600 "$temporary_output"
		mv -f "$temporary_output" "$destination"
	fi
}

ensure_directory_chain() {
	local relative current old_ifs component
	relative=$1
	current=
	old_ifs=$IFS
	IFS=/
	set -- $relative
	IFS=$old_ifs
	for component do
		[ -n "$component" ] || fail "invalid empty destination component"
		current="$current/$component"
		[ ! -L "$current" ] || fail "destination directory is a symbolic link: $current"
		if [ -e "$current" ]; then
			[ -d "$current" ] || fail "destination parent is not a directory: $current"
		else
			mkdir "$current" || fail "cannot create destination directory: $current"
			chmod 700 "$current"
		fi
	done
}

restore_regular_file() {
	local relative source destination parent parent_relative temporary root_record
	relative=$1
	source="$work/stage/$relative"
	destination=/$relative
	[ -f "$source" ] && [ ! -L "$source" ] ||
		fail "validated file disappeared from staging: $relative"
	if [ "$relative" = etc/shadow ]; then
		[ "$(grep -c '^root:' "$source" 2>/dev/null || true)" = 1 ] ||
			fail "backup contains an invalid shadow database"
		if [ -L /etc/shadow ]; then
			[ "$(readlink /etc/shadow)" = /tmp/etc/shadow ] ||
				fail "unexpected /etc/shadow link target"
		fi
		# Backups made by the preceding compatibility implementation contain
		# only the root row.  Merge that legacy form; current backups contain
		# and restore the complete shadow database like standard sysupgrade.
		if [ "$(wc -l < "$source")" = 1 ]; then
			[ -f "$destination" ] || fail "active shadow database is unavailable"
			root_record=$(cat "$source")
			printf '%s\n' "$root_record" | awk -F: '
				NF != 9 || $1 != "root" { exit 1 }
				$2 !~ /^[A-Za-z0-9!*$._\/-]*$/ { exit 1 }
				$3 !~ /^[0-9]*$/ || $4 !~ /^[0-9]*$/ || $5 !~ /^[0-9]*$/ ||
				$6 !~ /^[0-9]*$/ || $7 !~ /^[0-9]*$/ || $8 !~ /^[0-9]*$/ ||
				$9 !~ /^[0-9]*$/ { exit 1 }
			' || fail "backup contains an invalid root password record"
			awk -F: -v replacement="$root_record" '
				$1 == "root" && !done { print replacement; done = 1; next }
				$1 == "root" { next }
				{ print }
				END { if (!done) print replacement }
			' "$destination" > "$work/shadow-merged" ||
				fail "cannot prepare root password database"
			chmod 600 "$work/shadow-merged"
			source="$work/shadow-merged"
		fi
	fi
	parent=${destination%/*}
	parent_relative=${parent#/}
	ensure_directory_chain "$parent_relative"
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -f "$destination" ] || [ -L "$destination" ] ||
			fail "destination is not a regular file or symbolic link: $destination"
	fi
	# Avoid replacing an unchanged mount-backed file (notably /etc/hosts in
	# containers); no configuration change or metadata downgrade is needed.
	if [ -f "$destination" ] && [ ! -L "$destination" ] &&
		cmp -s "$source" "$destination"; then
		[ "$relative" != etc/shadow ] || chmod 600 "$destination" ||
			fail "cannot protect restored shadow database"
		return 0
	fi
	temporary=$(mktemp "$parent/.sbe-restore.XXXXXX") ||
		fail "cannot create temporary destination in $parent"
	cp -p "$source" "$temporary" || {
		rm -f "$temporary"
		fail "cannot stage restored file: $relative"
	}
	# Older backups inherited the vendor's world-readable temporary database.
	# Restore the real /etc file, never its volatile symlink target, and protect
	# it even when the archived mode predates the authentication fix.
	if [ "$relative" = etc/shadow ]; then
		chmod 600 "$temporary" || fail "cannot protect restored shadow database"
	fi
	mv -f "$temporary" "$destination" || {
		rm -f "$temporary"
		fail "cannot install restored file: $relative"
	}
}

restore_symbolic_link() {
	local relative source destination parent parent_relative target temporary_dir
	relative=$1
	source="$work/stage/$relative"
	destination=/$relative
	[ -L "$source" ] || fail "validated symbolic link disappeared from staging: $relative"
	target=$(readlink "$source") || fail "cannot read restored symbolic link: $relative"
	parent=${destination%/*}
	parent_relative=${parent#/}
	ensure_directory_chain "$parent_relative"
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -f "$destination" ] || [ -L "$destination" ] ||
			fail "symbolic-link destination is not replaceable: $destination"
	fi
	temporary_dir=$(mktemp -d "$parent/.sbe-restore-link.XXXXXX") ||
		fail "cannot create temporary link directory in $parent"
	ln -s -- "$target" "$temporary_dir/link" || {
		rmdir "$temporary_dir"
		fail "cannot stage restored symbolic link: $relative"
	}
	mv -f "$temporary_dir/link" "$destination" || {
		rm -f "$temporary_dir/link"
		rmdir "$temporary_dir"
		fail "cannot install restored symbolic link: $relative"
	}
	rmdir "$temporary_dir"
}

restore_backup() {
	local source_archive relative
	source_archive=$1
	case "$source_archive" in
		-) ;;
		*)
			safe_tmp_archive_path "$source_archive" ||
				fail "restore input must be '-' or a simple /tmp/*.tar.gz path"
			[ -f "$source_archive" ] && [ ! -L "$source_archive" ] ||
				fail "restore input must be a regular, non-link file"
			;;
	esac

	new_workdir
	if [ "$source_archive" = - ]; then
		(
			ulimit -f 32768
			cat > "$work/input.tar.gz"
		) 2>/dev/null || fail "restore input exceeds the 16 MiB compressed limit"
	else
		cp "$source_archive" "$work/input.tar.gz" || fail "cannot copy restore input"
	fi
	chmod 600 "$work/input.tar.gz"
	validate_gzip_archive "$work/input.tar.gz" "$work/list"
	mkdir -p "$work/stage"
	tar -xf "$work/archive.tar" -C "$work/stage" || fail "cannot extract validated archive"
	# Link-only vendor backups have no passwd/group payload. Preserve the
	# current persistent database instead of restoring a dangling /tmp link.
	# A shadow link has no recoverable password data and must be rejected.
	for relative in etc/passwd etc/group etc/shadow; do
		[ -L "$work/stage/$relative" ] || continue
		[ "$relative" != etc/shadow ] || fail "backup has no persistent shadow database"
		[ "$(readlink "$work/stage/$relative")" = "/tmp/$relative" ] ||
			fail "unexpected account database link in backup: $relative"
		[ -f "/$relative" ] && [ ! -L "/$relative" ] ||
			fail "current account database is not persistent: $relative"
		rm -f "$work/stage/$relative"
		cp -p "/$relative" "$work/stage/$relative" || fail "cannot retain account database: $relative"
	done

	while IFS= read -r relative; do
		if [ -L "$work/stage/$relative" ]; then
			restore_symbolic_link "$relative"
		else
			restore_regular_file "$relative"
		fi
	done < "$work/list"
	sync
	[ "$source_archive" = - ] || rm -f "$source_archive"
	logger -t sbe-backup "restored validated local configuration backup"
	echo "Configuration restored. Reboot to activate every restored service."
}

firmware_upgrade() {
	local image="$1" save_config="$2" test_only="$3"
	local validation valid upgrade_backup backup_json dependency

	case "$image" in
		/tmp/*.bin) ;;
		*) fail "firmware input must be a simple /tmp/*.bin path" ;;
	esac
	[ -f "$image" ] && [ ! -L "$image" ] ||
		fail "firmware input must be a regular, non-link file"
	case "${image#/tmp/}" in
		''|.*|*/*|*[!A-Za-z0-9._+-]*) fail "invalid firmware filename" ;;
	esac
	[ -x /usr/libexec/validate_firmware_image ] ||
		fail "firmware validator is unavailable"
	validation=$(/usr/libexec/validate_firmware_image "$image") ||
		fail "firmware validation command failed"
	valid=$(jsonfilter -s "$validation" -e '@.valid' 2>/dev/null || true)
	case "$valid" in
		1|true) ;;
		*) fail "firmware image failed board, metadata or payload validation" ;;
	esac

	# Load only the standard RAM-stage helpers plus our strict platform policy.
	# The custom backup implementation above remains the sole config selector.
	set +u
	. /lib/functions.sh
	. /lib/functions/system.sh
	. /usr/share/libubox/jshn.sh
	. /lib/upgrade/common.sh
	. /lib/upgrade/platform.sh
	set -u
	platform_check_image "$image" || fail "platform rejected the firmware image"
	[ "$test_only" = 0 ] || {
		echo "Image validation passed; no flash write was performed."
		return 0
	}

	upgrade_backup=
	if [ "$save_config" = 1 ]; then
		# Keep the temporary name inside safe_tmp_archive_path()'s deliberately
		# narrow allow-list.  The persistent p30 handoff may still store it as
		# .sysupgrade.tgz; this is only the source path passed to upgraded.
		upgrade_backup=/tmp/sysupgrade.tar.gz
		create_backup "$upgrade_backup"
	fi

	# QSDK's install_bin() may return 1 after successfully copying everything
	# when ldd lists the musl loader twice (once for libc).  Do not let `set -e`
	# mistake that duplicate destination for a copy failure; verify every staged
	# file explicitly instead.
	install_bin /sbin/upgraded || true
	[ -x "$RAM_ROOT/sbin/upgraded" ] ||
		fail "cannot stage /sbin/upgraded in the RAM upgrade root"
	for dependency in $(libs /sbin/upgraded); do
		[ -f "$RAM_ROOT/$dependency" ] ||
			fail "cannot stage RAM upgrade dependency: $dependency"
	done
	backup_json=
	[ -z "$upgrade_backup" ] || backup_json="\"backup\": $(json_string "$upgrade_backup"),"
	echo "Commencing verified SBE1V1K upgrade. Shell sessions will close."
	ubus call system sysupgrade "{
		\"prefix\": $(json_string "$RAM_ROOT"),
		\"path\": $(json_string "$image"),
		$backup_json
		\"command\": \"/lib/upgrade/do_stage2\",
		\"options\": { \"save_partitions\": 0 }
	}" || fail "procd refused the firmware upgrade request"
}

dispatch_firmware() {
	local save_config=1 test_only=0

	while [ "$#" -gt 0 ]; do
		case "$1" in
			-n) save_config=0 ;;
			-T|--test|--firmware-dry-run) test_only=1 ;;
			-q|-v) ;;
			-F|--force) fail "forced firmware upgrades are disabled" ;;
			-*) fail "unsupported firmware upgrade option: $1" ;;
			*) break ;;
		esac
		shift
	done
	[ "$#" -eq 1 ] || fail "usage: sysupgrade [-n] [-T|--test] /tmp/NAME.bin"
	firmware_upgrade "$1" "$save_config" "$test_only"
}

case "${1:-}" in
	-l|--list-backup)
		[ "$#" -eq 1 ] || fail "--list-backup takes no additional arguments"
		new_workdir
		build_backup_stage
		sed 's#^#/#' "$work/list"
		;;
	-b|--create-backup)
		[ "$#" -eq 2 ] || fail "usage: sysupgrade --create-backup {-|/tmp/NAME.tar.gz}"
		create_backup "$2"
		;;
	-r|--restore-backup)
		[ "$#" -eq 2 ] || fail "usage: sysupgrade --restore-backup {-|/tmp/NAME.tar.gz}"
		restore_backup "$2"
		;;
	*)
		dispatch_firmware "$@"
		;;
esac
